# Path to the mounted Samba share, or any local music folder.
# Relative paths are resolved from the repo root.
# Multiple libraries: comma-separated list (commas inside a path are not supported).
MUSIC_LIBRARY_PATH=./sample-music
# Example: MUSIC_LIBRARY_PATH=/mnt/a/Music,/mnt/b/Karaoke

# SQLite catalogue. Safe to delete; it will be rebuilt on the next scan.
DATABASE_PATH=./data/karaokej.sqlite

# Listen on all interfaces so other LAN devices can connect.
PORT=3000
HOST=0.0.0.0

# Optional: Vite dev LAN URL when accessing from another device (mirrored WSL / LAN IP)
# VITE_DEV_ORIGIN=http://192.168.50.55:5173
# Set to false if LAN clients show a blank page (disables HMR WebSocket on :5173)
# VITE_DEV_HMR=false

LRCLIB_BASE_URL=https://lrclib.net

# Optional: path to YT Saver GUI (Windows exe via WSL mount)
# YTSAVER_PATH=/mnt/c/Program Files/YT Saver/ytsaverw.exe

# Optional: yt-dlp CLI for YouTube search and MP3 download
# YTDLP_PATH=/mnt/c/Program Files/yt-dlp/yt-dlp.exe
# FFMPEG_PATH=/mnt/c/Program Files/YT Saver/ffmpeg.exe
# FFPROBE_PATH=/usr/bin/ffprobe
# Windows node.exe for yt-dlp YouTube JS challenges (WSL nvm node cannot be launched by yt-dlp.exe)
# YTDLP_NODE_PATH=/mnt/c/Program Files/nodejs/node.exe
# YTDLP_AUDIO_FORMAT=mp3

# Optional: Demucs CLI for AI vocal removal (HTDemucs source separation)
# DEMUCS_PATH=demucs
# DEMUCS_MODEL=htdemucs
# DEMUCS_STEM_CACHE_PATH=./data/karaoke-stems
# DEMUCS_TIMEOUT_MS=1800000
# DEMUCS_EXTRA_ARGS=--device cpu

# Library scan tuning (optional)
# Scans run in two phases: fast path indexing, then header tag reads for pending tracks.
# LIBRARY_SCAN_CHUNK_SIZE=1000
# Metadata parse concurrency (default 8). Tags read from a bounded header buffer.
# LIBRARY_SCAN_METADATA_CONCURRENCY=8
# Walk stat concurrency (defaults to metadata concurrency)
# LIBRARY_SCAN_WALK_CONCURRENCY=8
# LIBRARY_SCAN_FS_TIMEOUT_MS=15000
# Skip walking subtrees when directory mtime is unchanged (often unreliable on Samba)
# LIBRARY_SCAN_SKIP_UNCHANGED_DIRS=0
# Skip sidecar .lrc checks for unchanged audio files
# LIBRARY_SCAN_SKIP_LRC_ON_UNCHANGED=0

# Network library profile (recommended for Samba/NFS mounts):
# LIBRARY_SCAN_METADATA_CONCURRENCY=4
# LIBRARY_SCAN_WALK_CONCURRENCY=4
# LIBRARY_SCAN_SKIP_LRC_ON_UNCHANGED=1
